# Copy to deploy/postgres/.env (git-ignored) and set three distinct random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LIS_PG_SUPERUSER_PASSWORD=
LIS_OWNER_PASSWORD=
LIS_APP_PASSWORD=
# Optional, read by deploy/windows/backup-database.ps1 and restore-database.ps1 (defaults shown; the development
# instance of E:\LIS listens on 5433). On a server the same keys live in E:\lis-data\postgres.env.
#LIS_PG_HOST=127.0.0.1
#LIS_PG_PORT=5432
#LIS_PG_DATABASE=lis
#LIS_PG_SUPERUSER=postgres
#LIS_PG_BIN=C:\Program Files\PostgreSQL\17\bin

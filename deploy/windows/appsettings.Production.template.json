{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5100"
      }
    }
  },
  "Lis": {
    "Database": {
      "ConnectionString": "Host=127.0.0.1;Port=5432;Database=lis;Username=lis_app;Password=<SET: lis_app password>;Maximum Pool Size=50;Timeout=15;Command Timeout=60"
    },
    "Jwt": {
      "Issuer": "<SET: public origin of the site, e.g. https://lis.example.net>",
      "Audience": "platform-api",
      "SigningKey": "<SET: P-256 private key, PEM (deploy/SECRETS.md)>",
      "SigningKeyId": "<SET: key id, e.g. 2026-10-k1>",
      "SubjectEncryptionKey": "<SET: 32 random bytes, base64 (deploy/SECRETS.md)>",
      "PreviousSubjectEncryptionKeys": []
    },
    "DataProtection": {
      "MasterKey": "<SET: 32 random bytes, base64 (deploy/SECRETS.md)>"
    },
    "Security": {
      "AllowInsecureLocalDevelopment": false,
      "AllowedOrigins": [
        "<SET: public origin of the site, e.g. https://lis.example.net>"
      ],
      "Session": {
        "AccessTokenLifetime": "00:15:00",
        "BrowserSlidingLifetime": "08:00:00",
        "BrowserAbsoluteLifetime": "12:00:00",
        "MachineSlidingLifetime": "30.00:00:00",
        "MachineAbsoluteLifetime": "90.00:00:00",
        "LockoutThreshold": 5,
        "LockoutDuration": "00:30:00",
        "StepUpMaxAge": "00:05:00",
        "RefreshReuseGrace": "00:00:05",
        "OtpLength": 6,
        "OtpLifetime": "00:05:00",
        "OtpMaxAttempts": 5,
        "PasswordMinLength": 8
      },
      "RateLimits": {
        "GlobalPerMinute": 600,
        "TenantPerMinute": 3000,
        "CredentialAccountPer10Minutes": 20,
        "CredentialClientPerMinute": 60,
        "CredentialChallengePerMinute": 120,
        "RefreshPerMinute": 30,
        "MutationBurst": 120,
        "MutationPerSecond": 2
      },
      "Envelope": {
        "ChallengeLifetime": "00:02:00",
        "KeyRotation": "1.00:00:00",
        "KeyOverlap": "00:10:00",
        "RsaKeySize": 3072
      }
    },
    "Outbox": {
      "Enabled": true,
      "PollInterval": "00:00:02",
      "BatchSize": 50,
      "Lease": "00:00:30",
      "MaxAttempts": 10
    },
    "Files": {
      "Root": "E:\\lis-data\\files"
    },
    "Platform": {
      "PortalDomain": "<SET: portal domain of the client portals, e.g. skylis.app>"
    }
  }
}

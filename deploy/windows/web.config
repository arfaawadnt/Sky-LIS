<?xml version="1.0" encoding="utf-8"?>
<!--
  deploy/windows/web.config - template for the IIS sites lis-ui (production) and lis-ui-test (test).
  deploy/windows/install-ui-site.ps1 copies it next to the SPA build and replaces the two tokens:
    __API_PORT__       loopback port of the API service (5100 for NTLIS, 5180 for NTLIS_TEST)
    __SCRIPT_HASHES__  CSP hashes of the inline scripts the Angular build writes into index.html
  Requirements on the server: URL Rewrite 2.1 and Application Request Routing 3 with the proxy enabled at server
  level, and HTTP_X_FORWARDED_PROTO in <allowedServerVariables> (install-ui-site.ps1 checks and, on request, adds it).

  What it does:
   (a) /api, /health and /.well-known are reverse-proxied to http://127.0.0.1:__API_PORT__ on the same origin, so the
       refresh cookie (__Secure-rt; Path=/api/v1/auth; SameSite=Strict) and the Origin check work without CORS.
   (b) every other non-file URL is rewritten to /index.html for the Angular router.
   (c) security headers on the SPA responses only (the API sets its own; proxied responses are left untouched so no
       header is duplicated), index.html is never cached, hashed bundles are immutable, other static files revalidate.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <staticContent>
      <!-- Revalidate every static file by default (i18n/*.json, brand/*, favicon.ico are not hashed). -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Above the API's own per-endpoint limits (20 MB code-system CSV, 10 MB patient document); the API refuses the rest. -->
        <requestLimits maxAllowedContentLength="33554432" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <!-- (a) API, health and JWKS: same-origin reverse proxy to the loopback API. -->
        <rule name="lis-api-proxy-https" stopProcessing="true">
          <match url="^(api|health|\.well-known)(/.*)?$" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" ignoreCase="true" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:__API_PORT__/{R:0}" appendQueryString="true" logRewrittenUrl="false" />
        </rule>
        <rule name="lis-api-proxy-http" stopProcessing="true">
          <match url="^(api|health|\.well-known)(/.*)?$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:__API_PORT__/{R:0}" appendQueryString="true" logRewrittenUrl="false" />
        </rule>

        <!-- (b) Angular router: every URL that is not a file or a folder serves index.html. -->
        <rule name="lis-spa-fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>

      <outboundRules>
        <!-- (c) Headers for the SPA's own responses. Proxied responses carry the API's headers and are skipped. -->
        <preConditions>
          <preCondition name="lis-not-proxied" logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^(https?://[^/]+)?/(api|health|\.well-known)(/|$)" negate="true" />
          </preCondition>
          <preCondition name="lis-not-proxied-https" logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^(https?://[^/]+)?/(api|health|\.well-known)(/|$)" negate="true" />
            <add input="{HTTPS}" pattern="^on$" />
          </preCondition>
          <preCondition name="lis-html" logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^(https?://[^/]+)?/(api|health|\.well-known)(/|$)" negate="true" />
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
          <preCondition name="lis-hashed-asset" logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/(main|chunk|styles|polyfills|scripts)-[A-Za-z0-9_-]{6,}\.(js|mjs|css)(\?.*)?$" />
          </preCondition>
        </preConditions>

        <rule name="lis-h-nosniff" preCondition="lis-not-proxied">
          <match serverVariable="RESPONSE_X_Content_Type_Options" pattern=".*" />
          <action type="Rewrite" value="nosniff" />
        </rule>
        <rule name="lis-h-frame" preCondition="lis-not-proxied">
          <match serverVariable="RESPONSE_X_Frame_Options" pattern=".*" />
          <action type="Rewrite" value="DENY" />
        </rule>
        <rule name="lis-h-referrer" preCondition="lis-not-proxied">
          <match serverVariable="RESPONSE_Referrer_Policy" pattern=".*" />
          <action type="Rewrite" value="no-referrer" />
        </rule>
        <rule name="lis-h-permissions" preCondition="lis-not-proxied">
          <match serverVariable="RESPONSE_Permissions_Policy" pattern=".*" />
          <action type="Rewrite" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        </rule>
        <!-- Same value as the API's SecurityHeadersMiddleware; only over TLS (browsers ignore HSTS on http). -->
        <rule name="lis-h-hsts" preCondition="lis-not-proxied-https">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <action type="Rewrite" value="max-age=63072000; includeSubDomains" />
        </rule>
        <!-- SPA policy: the API answers with a deny-all policy of its own. Angular injects component styles inline
             (style-src 'unsafe-inline'); the build writes one inline script into index.html, allowed by hash. -->
        <rule name="lis-h-csp" preCondition="lis-html">
          <match serverVariable="RESPONSE_Content_Security_Policy" pattern=".*" />
          <action type="Rewrite" value="default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" />
        </rule>
        <!-- index.html (and every other HTML) is never stored: the next load must see the new bundle names. -->
        <rule name="lis-cache-html" preCondition="lis-html">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-store" />
        </rule>
        <!-- Bundles carry a content hash in their name (angular.json outputHashing: all). -->
        <rule name="lis-cache-immutable" preCondition="lis-hashed-asset">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>

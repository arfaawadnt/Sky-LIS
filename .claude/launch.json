{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "requirements-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "docs/requirements/src/serve.js",
        "docs/requirements",
        "5150"
      ],
      "port": 5150
    },
    {
      "name": "prototypes-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "docs/requirements/src/serve.js",
        "prototypes/dist",
        "5151"
      ],
      "port": 5151
    },
    {
      "name": "docs-prototypes-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "docs/requirements/src/serve.js",
        "docs/prototypes",
        "5152"
      ],
      "port": 5152
    },
    {
      "name": "srs-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "docs/requirements/src/serve.js",
        "docs/srs",
        "5153"
      ],
      "port": 5153
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Platform.WebApi/Platform.WebApi.csproj",
        "-c",
        "Release",
        "--no-build"
      ],
      "port": 5100
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "start"
      ],
      "port": 4300,
      "url": "http://127.0.0.1:4300"
    },
    {
      "name": "validation-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Platform.WebApi/Platform.WebApi.csproj",
        "-c",
        "Release",
        "--no-build",
        "--",
        "--Kestrel:Endpoints:Http:Url=http://127.0.0.1:5102"
      ],
      "port": 5102
    },
    {
      "name": "validation-spa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "start",
        "--",
        "--proxy-config",
        "proxy.validation.json"
      ],
      "port": 4300,
      "url": "http://127.0.0.1:4300"
    }
  ]
}
